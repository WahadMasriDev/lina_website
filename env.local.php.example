<?php
// Copy this file to env.local.php (already in .gitignore -- never commit the
// real one) and fill in the real values. Only needed on hosting that has no
// environment-variable panel (e.g. plain Hostinger). Docker/Portainer
// deployments set these as stack environment variables instead and don't
// need this file at all.
putenv('DB_HOST=localhost');
putenv('DB_NAME=your_real_db_name');
putenv('DB_USER=your_real_db_user');
putenv('DB_PASS=your_real_db_password');
